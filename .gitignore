# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Local configuration. Never committed.
.env
.env.*

# CDK
infra/cdk.out/
infra/.cdk.staging/
# The CDK caches context lookups here. Ignored rather than committed because the stacks
# make no lookups (synth needs no credentials), so anything appearing in it is a lookup
# someone added — worth noticing, not caching.
infra/cdk.context.json

# Node: only the CDK CLI, pinned in infra/package.json
node_modules/

# Claude Code worktrees: live repositories for other sessions, never part of this one
.claude/worktrees/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
